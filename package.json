{
  "name": "spinup",
  "version": "0.3.0",
  "description": "Developer CLI that detects a project and launches its dev environment from anywhere.",
  "type": "module",
  "bin": {
    "spinup": "src/cli.ts"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "bun test",
    "build": "bash scripts/build-release.sh --output dist/spinup",
    "build:release": "bash scripts/build-release.sh"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.8.4",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "execa": "^9.5.2",
    "yaml": "^2.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  },
  "license": "MIT"
}
